{
  "version": 8,
  "name": "ASIT Vector Tiles - EPSG:2056 TEST",
  "glyphs": "https://vt.asit-asso.ch/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "asit": {
      "type": "vector",
      "tiles": ["https://vt.asit-asso.ch/tiles/asit/v0.1/2056/{z}/{x}/{y}.mvt"],
      "minzoom": 0,
      "maxzoom": 10
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#f4f3f0" }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "asit",
      "source-layer": "landcover",
      "paint": { "fill-color": "#e0ebd3" }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "asit",
      "source-layer": "water",
      "paint": { "fill-color": "#a1cbe6" }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "asit",
      "source-layer": "building",
      "paint": {
        "fill-color": "#d9d0c7",
        "fill-outline-color": "#b5a392"
      }
    },
    {
      "id": "street",
      "type": "line",
      "source": "asit",
      "source-layer": "street",
      "paint": {
        "line-color": "#ffffff",
        "line-width": 2
      }
    },
    {
      "id": "boundary",
      "type": "line",
      "source": "asit",
      "source-layer": "boundary",
      "paint": {
        "line-color": "#999999",
        "line-width": 1
      }
    }
  ]
}
