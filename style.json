  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f8f9fa"
      }
    },
    {
      "id": "landuse_polygons",
      "type": "fill",
      "source": "asit_vt",
      "source-layer": "landuse",
      "paint": {
        "fill-color": "#e9ecef",
        "fill-opacity": 0.5
      }
    },
    {
      "id": "water_polygons",
      "type": "fill",
      "source": "asit_vt",
      "source-layer": "water",
      "paint": {
        "fill-color": "#a5d8ff"
      }
    },
    {
      "id": "building_polygons",
      "type": "fill",
      "source": "asit_vt",
      "source-layer": "building",
      "paint": {
        "fill-color": "#ced4da",
        "fill-outline-color": "#adb5bd"
      }
    },
    {
      "id": "roads_lines",
      "type": "line",
      "source": "asit_vt",
      "source-layer": "transportation",
      "layout": {
        "line-join": "round",
        "line-cap": "round"
      },
      "paint": {
        "line-color": "#ffffff",
        "line-width": 2
      }
    },
    {
      "id": "place_labels",
      "type": "symbol",
      "source": "asit_vt",
      "source-layer": "place",
      "layout": {
        "text-field": "{name}",
        "text-size": 12
      },
      "paint": {
        "text-color": "#212529",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1
      }
    }
  ]
}
